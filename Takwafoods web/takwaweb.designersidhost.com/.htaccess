# --- internal tooling is never reachable in production ---
# The photo index and the Arabic text index are local editing tools. They are
# excluded from the deploy, but cPanel's copy step never deletes, so a copy
# left by an earlier deploy stays in public_html and keeps being served --
# _photo-index.html was answering 200 on the live site. This denies them
# outright, so it cannot happen again whatever is sitting on disk.
# Any extension, not just html and json: the underscore prefix is the site's
# convention for "internal, never public", and it is used for image backups
# too. _flavora-cafe-og.jpg.bak was reachable while this pattern ended in
# \.(html|json)$.
<FilesMatch "^_">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- article URLs renamed from the purchased template's car slugs ---
# Kept so links already shared or indexed under the old paths still land.
Redirect 301 /blog/car-on-highway-directional-road-signs.html /blog/quality-begins-with-every-test.html
Redirect 301 /blog/mini-coupe-parking-on-the-highway-bridge.html /blog/introducing-enna-soups.html
Redirect 301 /blog/professional-man-working-on-car-full-shot.html /blog/delivering-freshness-across-the-region.html
Redirect 301 /blog/stylish-and-elegant-old-man-in-a-car-salon.html /blog/flavora-cafe-opens-its-doors.html
Redirect 301 /blog/car-on-highway-directional-road-signs-ar.html /blog/quality-begins-with-every-test-ar.html
Redirect 301 /blog/mini-coupe-parking-on-the-highway-bridge-ar.html /blog/introducing-enna-soups-ar.html
Redirect 301 /blog/professional-man-working-on-car-full-shot-ar.html /blog/delivering-freshness-across-the-region-ar.html
Redirect 301 /blog/stylish-and-elegant-old-man-in-a-car-salon-ar.html /blog/flavora-cafe-opens-its-doors-ar.html

# --- browser caching ---------------------------------------------------------
# The server sends Last-Modified but no Cache-Control, so a returning visitor
# re-checks all 65 assets on every page load. Each one is a round trip to Syria
# and back even when the answer is "unchanged".
#
# Images, fonts, CSS and JS are given a year. That is safe because these files
# change by being replaced through the editing tools and then deployed -- and a
# deploy changes the filename for products and news, while a swapped photo is a
# deliberate act after which a hard refresh is expected.
#
# HTML is deliberately NOT cached: pages must reflect a deploy immediately, or
# publishing a correction would leave visitors on the old copy for a year.
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType video/mp4                     "access plus 1 year"

    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType text/javascript               "access plus 1 year"

    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf                      "access plus 1 year"

    ExpiresByType text/html                     "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4|css|js|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --- compression -------------------------------------------------------------
# gzip is already active for HTML and CSS on this host, but it is not applied
# to every text type. This makes it explicit rather than relying on whatever
# the host happens to have configured.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- turn off directory listing ---------------------------------------------
# Without this, a folder with no index.html shows Apache's auto-generated
# "Index of /uploads" -- letting anyone walk the whole tree and enumerate every
# file, including unused and draft assets. The files are public, but the map of
# them should not be.
Options -Indexes

# --- security headers -------------------------------------------------------
# None were set. These are the low-risk, high-value ones. A Content-Security-
# Policy is deliberately left out here: the site loads Google Fonts, Facebook
# and LinkedIn, and a wrong CSP silently breaks the page -- it needs testing
# against the real site rather than being pasted in blind.
<IfModule mod_headers.c>
    # tell browsers to stick to HTTPS for a year (the redirect already forces
    # it; this stops the first plain-http request even being made)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # do not let the site be framed by another origin (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    # do not let the browser second-guess a file's declared type
    Header always set X-Content-Type-Options "nosniff"
    # do not leak the full URL to other sites in the Referer header
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # switch off powerful APIs the site never uses
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# --- stop announcing the server version -------------------------------------
<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>
ServerSignature Off
